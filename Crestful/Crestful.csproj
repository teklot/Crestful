<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Crestful</Title>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>Crestful is the core convention-first REST framework for ASP.NET Core. Define a resource once and receive a production-ready CRUD API: automatic resource discovery, generated Minimal API endpoints (GET, GET/{id}, POST, PUT, PATCH, DELETE), a thread-safe in-memory data source, before/after lifecycle hooks, custom endpoints, and standardized ProblemDetails errors — plain ASP.NET Core underneath.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>Crestful</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>Crestful;REST;AspNetCore;MinimalAPI;API;Framework;dotnet-library</PackageTags>
    <PackageReleaseNotes>
      Optimistic concurrency control for your resources.
      - Validators: every response carries an entity tag and a last-modified date, so a client can say which version it read.
      - Updates and deletes: the client must send that version back, otherwise the request is refused with 428 precondition required.
      - Stale versions: a request built on an outdated version is rejected with 412 precondition failed, so nobody's changes are silently overwritten.
      - Conditional reads: asking for a version that has not changed returns 304 not modified with no body.
    </PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/Crestful</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/Crestful.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The Web SDK sets WarnOnPackingNonPackableProject=true, which makes `dotnet pack` warn
         on this non-packable project. This sample is intentionally not a package, so suppress it. -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentHtml.Core" />
    <PackageReference Include="FluentHtml.Http" />
    <PackageReference Include="FluentHtml.Bootstrap" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <ProjectReference Include="..\Crestful\Crestful.csproj" />
    <ProjectReference Include="..\Crestful.EFCore\Crestful.EFCore.csproj" />
    <ProjectReference Include="..\Crestful.Validation\Crestful.Validation.csproj" />
  </ItemGroup>
</Project>

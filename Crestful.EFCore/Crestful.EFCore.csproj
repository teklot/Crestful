<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Title>Crestful.EFCore</Title>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>Crestful.EFCore backs Crestful resources with EF Core. Scans registered DbContexts for DbSet&lt;T&gt; entities that implement IResource and registers scoped EF Core data sources — DbContext discovery, entity tracking, relationships, and transactions with no repository layer.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>Crestful.EFCore</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>Crestful;EFCore;EntityFrameworkCore;Persistence;REST;API;dotnet-library</PackageTags>
    <PackageReleaseNotes>EF Core query translation for filtering, sorting, pagination, search, and field selection — translates ResourceQueryContext to LINQ expressions.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/Crestful</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/Crestful.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <ProjectReference Include="..\Crestful\Crestful.csproj" />
  </ItemGroup>

</Project>
